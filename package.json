{
  "name": "mrs-marking",
  "version": "1.0.0",
  "description": "Backend CAP Node.js do fluxo de marcação georreferenciada da MRS",
  "private": true,
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/mcp-server": "^0.0.5",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.4"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "fiscal1": {
            "password": "fiscal1",
            "roles": [
              "Fiscal"
            ]
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    },
    "[production]": {
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      },
      "features": {
        "in_memory_db": true
      }
    }
  }
}
