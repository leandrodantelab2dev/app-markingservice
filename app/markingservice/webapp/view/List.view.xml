<mvc:View
	controllerName="markingservice.controller.List"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'markingservice/model/formatter',
		DateTimeOffset: 'sap/ui/model/odata/type/DateTimeOffset'
	}">

	<Page id="listPage" title="{i18n>listTitle}">
		<headerContent>
			<Button icon="sap-icon://synchronize" tooltip="{i18n>btnSync}" press=".onSync"/>
			<Button icon="sap-icon://add" text="{i18n>btnNewMarking}" type="Emphasized" press=".onNewMarking"/>
		</headerContent>
		<content>
			<HBox id="kpiBar" justifyContent="Center" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
				<VBox alignItems="Center" class="sapUiMediumMarginBeginEnd">
					<ObjectNumber id="kpiTotalNumber" number="{kpi>/total}" emphasized="false"/>
					<Label text="{i18n>kpiTotal}"/>
				</VBox>
				<VBox alignItems="Center" class="sapUiMediumMarginBeginEnd">
					<ObjectNumber id="kpiCriticalNumber" number="{kpi>/critical}" state="Error" emphasized="true"/>
					<Label text="{i18n>kpiCritical}"/>
				</VBox>
				<VBox alignItems="Center" class="sapUiMediumMarginBeginEnd">
					<ObjectNumber id="kpiAttentionNumber" number="{kpi>/attention}" state="Warning" emphasized="true"/>
					<Label text="{i18n>kpiAttention}"/>
				</VBox>
				<VBox alignItems="Center" class="sapUiMediumMarginBeginEnd">
					<ObjectNumber id="kpiOkNumber" number="{kpi>/ok}" state="Success" emphasized="true"/>
					<Label text="{i18n>kpiOk}"/>
				</VBox>
			</HBox>
			<Table
				id="markingTable"
				items="{
					path: '/ServiceMarking',
					parameters: {
						$expand: 'lineSection,serviceType,condition,status'
					},
					sorter: { path: 'markingDate', descending: true }
				}"
				noDataText="{i18n>listEmptyText}"
				growing="true"
				growingScrollToLoad="true"
				itemPress=".onMarkingPress">

				<headerToolbar>
					<OverflowToolbar>
						<Label text="{i18n>filterStatusLabel}" labelFor="statusFilter" class="sapUiTinyMarginEnd"/>
						<Select
							id="statusFilter"
							forceSelection="false"
							autoAdjustWidth="true"
							tooltip="{i18n>filterStatusPlaceholder}"
							items="{/MarkingStatus}"
							change=".onFilterChange">
							<core:Item key="{code}" text="{name}"/>
						</Select>
						<Label text="{i18n>filterLineSectionLabel}" labelFor="lineSectionFilter" class="sapUiSmallMarginBegin sapUiTinyMarginEnd"/>
						<Select
							id="lineSectionFilter"
							forceSelection="false"
							autoAdjustWidth="true"
							tooltip="{i18n>filterLineSectionPlaceholder}"
							items="{/LineSection}"
							change=".onFilterChange">
							<core:Item key="{ID}" text="{code}"/>
						</Select>
						<ToolbarSpacer/>
						<Button icon="sap-icon://clear-filter" tooltip="{i18n>btnClearFilters}" press=".onClearFilters">
							<layoutData>
								<OverflowToolbarLayoutData priority="NeverOverflow"/>
							</layoutData>
						</Button>
					</OverflowToolbar>
				</headerToolbar>

				<columns>
					<Column importance="High"><Text text="{i18n>colLineSection}"/></Column>
					<Column demandPopin="true" minScreenWidth="Tablet" importance="Low"><Text text="{i18n>colKm}"/></Column>
					<Column demandPopin="true" minScreenWidth="Tablet" importance="Low"><Text text="{i18n>colServiceType}"/></Column>
					<Column demandPopin="true" minScreenWidth="Tablet" importance="Medium"><Text text="{i18n>colCondition}"/></Column>
					<Column importance="High"><Text text="{i18n>colStatus}"/></Column>
					<Column demandPopin="true" minScreenWidth="Tablet" importance="Low"><Text text="{i18n>colDate}"/></Column>
				</columns>

				<items>
					<ColumnListItem type="Navigation">
						<cells>
							<Text text="{lineSection/code}"/>
							<Text text="{
								parts: ['kmFrom', 'kmTo'],
								formatter: 'formatter.kmRange'
							}"/>
							<Text text="{serviceType/name}"/>
							<ObjectStatus
								text="{condition/name}"
								state="{
									path: 'condition_code',
									formatter: 'formatter.conditionState'
								}"/>
							<Text text="{status/name}"/>
							<Text text="{
								path: 'markingDate',
								type: 'DateTimeOffset',
								formatOptions: { style: 'medium' }
							}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>

</mvc:View>
