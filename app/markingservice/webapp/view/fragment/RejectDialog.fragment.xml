<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog title="{i18n>rejectDialogTitle}" id="rejectDialog">
		<content>
			<VBox class="sapUiSmallMargin">
				<Label text="{i18n>rejectReasonLabel}" labelFor="rejectReasonInput"/>
				<TextArea id="rejectReasonInput" rows="4" width="100%"/>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>rejectConfirm}" type="Emphasized" press=".onConfirmReject"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>btnCancel}" press=".onCancelReject"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
