{
	"_version": "2.0.0",

	"sap.app": {
		"id": "markingservice",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "${version}"
		},
		"dataSources": {
			"default": {
				"uri": "/odata/v4/marking/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		},
		"sourceTemplate": {
			"id": "@ui5/mcp-server:js",
			"version": "0.2.17"
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"rootView": {
			"viewName": "markingservice.view.App",
			"type": "XML",
			"id": "app"
		},

		"dependencies": {
			"minUI5Version": "1.151.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.ui.layout": {}
			}
		},

		"handleValidation": true,

		"contentDensities": {
			"compact": true,
			"cozy": true
		},

		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "markingservice.i18n.i18n",
					"async": true
				}
			},
			"": {
				"dataSource": "default",
				"preload": true,
				"settings": {
					"autoExpandSelect": true,
					"earlyRequests": true,
					"operationMode": "Server"
				}
			}
		},

		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "markingservice.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "main",
					"target": "main"
				},
				{
					"pattern": "ServiceMarking/new",
					"name": "create",
					"target": "detail"
				},
				{
					"pattern": "ServiceMarking/{objectId}",
					"name": "detail",
					"target": "detail"
				}
			],
			"targets": {
				"main": {
					"id": "main",
					"name": "List"
				},
				"detail": {
					"id": "detail",
					"name": "Detail"
				}
			}
		}
	}
}
